// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model users {
  id         Int           @id @default(autoincrement())
  email      String        @unique @db.VarChar(255)
  nickname   String?       @db.VarChar(255)
  avatar_url String?       @db.VarChar(255)
  created_at DateTime?     @db.Timestamptz()
  orders     orders[]
  wallpapers wallpapers[]
  user_roles user_roles[]
  created_redeem_codes redeem_codes[] @relation("redeem_code_creator")
  used_redeem_codes    redeem_codes[] @relation("redeem_code_user")
  prompt_optimizations prompt_optimizations[]
  favorites  favorites[]
  system_wallpapers    system_wallpapers[]
  projects   projects[]
  canvas_assets canvas_assets[]
  executions executions[]
}

model roles {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(50)
  code        String       @unique @db.VarChar(50)
  description String?      @db.VarChar(255)
  user_roles  user_roles[]
}

model user_roles {
  user_id Int
  role_id Int
  user    users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    roles @relation(fields: [role_id], references: [id], onDelete: Cascade)
  @@id([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
}

model wallpapers {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  img_description     String?   @db.Text
  img_size            String?   @db.VarChar(255)
  model_key           String?   @db.VarChar(50)
  aspect_ratio_key    String?   @db.VarChar(50)
  img_path            String?   @db.Text
  img_thumbnail_path  String?   @db.Text
  img_watermark_path  String?   @db.Text
  status              Int       @default(0) // 0: Generating, 1: Success, 2: Failed
  failure_reason      String?   @db.Text
  llm_params          Json?
  is_public           Boolean   @default(false)
  created_at          DateTime? @db.Timestamptz()
  deleted_at          DateTime? @db.Timestamptz()
  permanently_deleted_at DateTime? @db.Timestamptz()
  is_permanently_delete Boolean   @default(false)
  is_delete           Boolean   @default(false)
  user                users     @relation(fields: [user_id], references: [id])
  system_wallpapers   system_wallpapers[]
  @@index([user_id, is_delete, is_permanently_delete, created_at(sort: Desc)])
}

model favorites {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  system_wallpaper_id Int?
  created_at          DateTime? @default(now()) @db.Timestamptz()
  user             users               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  system_wallpaper system_wallpapers?  @relation(fields: [system_wallpaper_id], references: [id], onDelete: Cascade)
  @@unique([user_id, system_wallpaper_id])
  @@index([user_id])
  @@index([system_wallpaper_id])
}

model orders {
  id                Int       @id @default(autoincrement())
  order_no          String    @unique @db.VarChar(255)
  created_at        DateTime? @db.Timestamptz()
  user_id           Int
  amount            Int
  plan              String?   @db.VarChar(50)
  expired_at        DateTime? @db.Timestamptz()
  order_status      Int       @db.SmallInt
  paied_at          DateTime? @db.Timestamptz()
  credits           Int
  user              users     @relation(fields: [user_id], references: [id])
  @@index([user_id])
}

model system_wallpapers {
  id             Int       @id @default(autoincrement())
  img_description String?  @db.Text
  img_size       String?   @db.VarChar(255)
  model_key      String?   @db.VarChar(50)
  aspect_ratio_key String? @db.VarChar(50)
  img_path       String?   @db.Text
  img_thumbnail_path String? @db.Text
  img_watermark_path String? @db.Text
  llm_params     Json?
  created_at     DateTime? @db.Timestamptz()
  updated_at     DateTime? @db.Timestamptz()
  is_active      Boolean   @default(true)
  creator_id     Int?      @db.Integer
  wallpaper_id   Int?      @db.Integer
  user           users?    @relation(fields: [creator_id], references: [id])
  wallpaper      wallpapers? @relation(fields: [wallpaper_id], references: [id])
  favorites      favorites[]
  @@index([is_active, created_at(sort: Desc)])
  @@index([creator_id, is_active, created_at(sort: Desc)])
}

model user_balance {
  user_id       Int       @id @db.Integer
  total_credits Int
  updated_at    DateTime? @db.Timestamptz()
}

model dictionaries {
  id          Int       @id @default(autoincrement())
  category    String    @db.VarChar(50)
  key         String    @db.VarChar(100)
  type        String    @default("") @db.VarChar(20)
  label_en    String?   @db.VarChar(100)
  label_zh    String?   @db.VarChar(100)
  sort_order  Int       @default(0)
  is_active   Boolean   @default(true)
  created_at  DateTime? @db.Timestamptz()
  updated_at  DateTime? @db.Timestamptz()
  @@unique([category, key])
  @@index([category, is_active])
}

enum TransactionType {
  gift
  purchase
  consume
  refund
  expire
}

model credit_transactions {
  id           Int             @id @default(autoincrement())
  user_id      Int             @db.Integer
  amount       Int
  type         TransactionType
  remark       String?         @db.VarChar(255)
  balance_after Int
  created_at   DateTime?       @db.Timestamptz()
}

model redeem_codes {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(255)
  creator_id  Int       @db.Integer
  created_at  DateTime? @db.Timestamptz()
  is_used     Boolean   @default(false)
  used_by     Int?      @db.Integer
  used_at     DateTime? @db.Timestamptz()
  creator users  @relation("redeem_code_creator", fields: [creator_id], references: [id])
  user    users? @relation("redeem_code_user", fields: [used_by], references: [id])
  @@index([creator_id])
  @@index([used_by])
}

model prompt_optimizations {
  id               Int       @id @default(autoincrement())
  user_id          Int
  original_prompt  String    @db.Text
  optimized_prompt String    @db.Text
  created_at       DateTime? @default(now()) @db.Timestamptz()
  user             users     @relation(fields: [user_id], references: [id])
  @@index([user_id])
}

// ---------------------------------------------------------------------------
// AI 画布素材生成平台 (Canvas) domain models
// ---------------------------------------------------------------------------

model projects {
  id             Int       @id @default(autoincrement())
  user_id        Int
  name           String    @db.VarChar(255)
  cover_asset_id Int?
  visibility     String    @default("private") @db.VarChar(20)
  is_deleted     Boolean   @default(false)
  created_at     DateTime? @default(now()) @db.Timestamptz()
  updated_at     DateTime? @default(now()) @db.Timestamptz()
  deleted_at     DateTime? @db.Timestamptz()
  user           users     @relation(fields: [user_id], references: [id])
  canvases       canvases[]
  @@index([user_id, is_deleted, updated_at(sort: Desc)])
}

model canvases {
  id            Int         @id @default(autoincrement())
  project_id    Int
  revision      Int         @default(1)
  viewport_json Json?
  created_at    DateTime?   @default(now()) @db.Timestamptz()
  updated_at    DateTime?   @default(now()) @db.Timestamptz()
  project       projects    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  nodes         nodes[]
  edges         edges[]
  executions    executions[]
  @@index([project_id])
}

// 节点/边使用客户端生成的 UUID 主键：乐观创建无需服务端回传 id 映射，
// 保存操作天然幂等（upsert by id），多端也不会冲突。
model nodes {
  id                  String          @id @default(uuid()) @db.VarChar(36)
  canvas_id           Int
  type                String          @db.VarChar(50)
  x                   Int
  y                   Int
  current_revision_id Int?            @unique
  created_at          DateTime?       @default(now()) @db.Timestamptz()
  updated_at          DateTime?       @default(now()) @db.Timestamptz()
  canvas              canvases        @relation(fields: [canvas_id], references: [id], onDelete: Cascade)
  revisions           node_revisions[]
  current_revision    node_revisions? @relation("current_node_revision", fields: [current_revision_id], references: [id])
  step_runs           step_runs[]
  @@index([canvas_id])
}

model node_revisions {
  id           Int             @id @default(autoincrement())
  node_id      String          @db.VarChar(36)
  config_json  Json
  content_hash String?         @db.VarChar(64)
  created_at   DateTime?       @default(now()) @db.Timestamptz()
  node         nodes           @relation(fields: [node_id], references: [id], onDelete: Cascade)
  current_of   nodes?          @relation("current_node_revision")
  step_runs    step_runs[]
  @@index([node_id])
}

model edges {
  id             String   @id @default(uuid()) @db.VarChar(36)
  canvas_id      Int
  source_node_id String   @db.VarChar(36)
  source_port    String   @db.VarChar(50)
  target_node_id String   @db.VarChar(36)
  target_port    String   @db.VarChar(50)
  created_at     DateTime? @default(now()) @db.Timestamptz()
  canvas         canvases @relation(fields: [canvas_id], references: [id], onDelete: Cascade)
  @@index([canvas_id])
  @@index([source_node_id])
  @@index([target_node_id])
}

model canvas_assets {
  id          Int      @id @default(autoincrement())
  user_id     Int
  media_type  String   @db.VarChar(20)
  storage_key String   @db.Text
  sha256      String?  @db.VarChar(64)
  status      String   @default("ready") @db.VarChar(20)
  created_at  DateTime? @default(now()) @db.Timestamptz()
  user        users    @relation(fields: [user_id], references: [id])
  @@index([user_id, media_type, created_at(sort: Desc)])
}

model executions {
  id               Int            @id @default(autoincrement())
  canvas_id        Int
  user_id          Int
  idempotency_key  String         @db.VarChar(255)
  scope            String         @db.VarChar(20)
  root_node_id     String?        @db.VarChar(36)
  snapshot_json    Json?
  status           String         @default("queued") @db.VarChar(30)
  reserved_credits Int            @default(0)
  captured_credits Int            @default(0)
  error_code       String?        @db.VarChar(50)
  created_at       DateTime?      @default(now()) @db.Timestamptz()
  updated_at       DateTime?      @default(now()) @db.Timestamptz()
  canvas           canvases       @relation(fields: [canvas_id], references: [id], onDelete: Cascade)
  user             users          @relation(fields: [user_id], references: [id])
  step_runs        step_runs[]
  @@unique([user_id, idempotency_key])
  @@index([canvas_id, created_at(sort: Desc)])
  @@index([status, updated_at])
}

model step_runs {
  id               Int             @id @default(autoincrement())
  execution_id     Int
  node_id          String          @db.VarChar(36)
  node_revision_id Int
  status           String          @default("pending") @db.VarChar(30)
  input_hash       String?         @db.VarChar(64)
  output_json      Json?
  error_code       String?         @db.VarChar(50)
  error_message    String?         @db.Text
  credits_consumed Int             @default(0)
  created_at       DateTime?       @default(now()) @db.Timestamptz()
  updated_at       DateTime?       @default(now()) @db.Timestamptz()
  execution        executions      @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  node             nodes           @relation(fields: [node_id], references: [id], onDelete: Cascade)
  node_revision    node_revisions  @relation(fields: [node_revision_id], references: [id])
  provider_jobs    provider_jobs[]
  @@unique([execution_id, node_id])
  @@index([execution_id])
  @@index([node_id])
}

// 供应商异步任务（视频等长任务）：submit 落库 external_id 后由 poller 扫描器驱动轮询。
// 技术方案 §八点四 / §十四点三。
model provider_jobs {
  id             Int        @id @default(autoincrement())
  step_run_id    Int
  provider       String     @default("ark") @db.VarChar(50)
  external_id    String?    @db.VarChar(255)
  status         String     @default("submitting") @db.VarChar(30)
  raw_status     String?    @db.VarChar(100)
  poll_count     Int        @default(0)
  next_poll_at   DateTime?  @default(now()) @db.Timestamptz()
  created_at     DateTime?  @default(now()) @db.Timestamptz()
  updated_at     DateTime?  @default(now()) @db.Timestamptz()
  step_run       step_runs  @relation(fields: [step_run_id], references: [id], onDelete: Cascade)
  @@unique([provider, external_id])
  @@index([status, next_poll_at])
  @@index([step_run_id])
}
